# Macro-compute .env — points at macro-data's private IP for postgres/redis.

DATABASE_URL=postgresql+asyncpg://macro:<password>@<data-private-ip>:5432/macro
SYNC_DATABASE_URL=postgresql://macro:<password>@<data-private-ip>:5432/macro
REDIS_URL=redis://<data-private-ip>:6379/0

API_PORT=8000

POLYGON_API_KEY=<your-polygon-key>
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

TELEGRAM_BOT_TOKEN=<your-bot-token>
TELEGRAM_CHAT_ID=<your-chat-id>

TZ=UTC
LOG_LEVEL=INFO
